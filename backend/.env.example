# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 커밋하지 마세요.

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Database
DATABASE_URL=sqlite:///./nemo_stock.db

# Worker / Scheduler
WORKER_POOL_SIZE=4
SCHEDULER_TICK_SECONDS=1.0

# Providers: dummy | historical | toss (market), dummy | toss (order)
MARKET_DATA_PROVIDER=dummy
ORDER_PROVIDER=dummy

# OpenAI (백엔드 전용, 프론트에 절대 노출하지 말 것)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 공공데이터포털 (금융위원회_주식시세정보) 서비스키
DATA_GO_KR_SERVICE_KEY=

# OpenDART(공시) API 키
DART_API_KEY=

# Toss증권 Open API (실험적/미검증 — 사전신청 승인 후 사용 가능)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_BASE_URL=https://apis.tossinvest.com
TOSS_ACCOUNT_ID=

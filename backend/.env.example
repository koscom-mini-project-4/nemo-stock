# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 커밋하지 마세요.

# Auth — 이 PoC는 인증 게이트가 없다(§0-17). admin 계정 정보는 시드값(단일 계정)으로만 쓴다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Database
DATABASE_URL=sqlite:///./nemo_stock.db

# Worker / Scheduler
WORKER_POOL_SIZE=4
SCHEDULER_TICK_SECONDS=1.0

# Providers: dummy | historical | toss | koscom (market), dummy | toss (order) | kis
MARKET_DATA_PROVIDER=dummy
ORDER_PROVIDER=dummy

# AI 제공자 선택: openai | claude. 이 값 하나로 워크플로 초안/챗봇/백테스트 설명/자유
# 프롬프트 노드 등 전부가 어느 쪽을 쓸지 결정된다(ai.news_signal의 내부 뉴스 분류만 예외 —
# vendored 파이프라인이라 항상 OpenAI, 아래 OPENAI_API_KEY를 그대로 씀).
AI_PROVIDER=openai

# OpenAI (백엔드 전용, 프론트에 절대 노출하지 말 것)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Anthropic Claude (AI_PROVIDER=claude일 때만 사용, 백엔드 전용)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 전략 생성(AI 초안 생성, POST /ai/generate-draft)만 다른 모델을 쓰고 싶을 때 설정.
# 비워두면 위 OPENAI_MODEL/ANTHROPIC_MODEL(AI_PROVIDER에 따라 결정)과 동일한 모델을 쓴다.
# 나머지 AI 기능(캔버스 챗봇/백테스트 설명/뉴스 감성/자유 프롬프트)은 항상 기본 모델을 쓴다.
AI_MODEL_STRATEGY=

# 공공데이터포털 (금융위원회_주식시세정보) 서비스키
# 주의: data.go.kr의 "URL Encoding" 값이 아니라 디코딩된 원본 값을 넣어야 한다(httpx가 자동 인코딩).
DATA_GO_KR_SERVICE_KEY=

# OpenDART(공시) API 키
DART_API_KEY=

# 백테스트 시도 시 종목 시세 데이터가 없으면 네이버 차트 API로 자동 수집할지 여부
AUTO_INGEST_PRICES=true

# Toss증권 Open API (실험적/미검증 — 사전신청 승인 후 사용 가능)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_BASE_URL=https://apis.tossinvest.com
TOSS_ACCOUNT_ID=

# KOSCOM CHECK-API (실험적/미검증 — CHECK 단말 구독 고객 전용, docs/koscom-api/README.md 참조)
KOSCOM_CUST_ID=
KOSCOM_AUTH_KEY=
KOSCOM_BASE_URL=https://checkapi.koscom.co.kr

# 한국투자증권(KIS) Open API 모의투자 (공식 예제코드 대조 확인, 실제 앱키로는 미검증 —
# 발급받은 앱키/시크릿을 아래에 채워 넣으세요. 계좌번호는 "12345678-01" 형식)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_IS_PAPER=true
KIS_ACCOUNT_NO=
